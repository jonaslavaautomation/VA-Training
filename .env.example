# Copy this file to .env.local and fill in values from
# Supabase Dashboard -> Project Settings -> API (or "API Keys").
#
# ONLY the public "anon" key (or the newer "publishable" key, sb_publishable_…)
# belongs here. It is safe in the browser because every table is protected by
# Row Level Security and all admin actions go through the admin-members Edge Function.
#
# NEVER put the service_role / secret key in any VITE_* variable — anything
# prefixed with VITE_ is bundled into the public JavaScript. The app refuses to
# start if it detects one.
#
# Leave both empty during LOCAL development (`npm run dev`) to explore the UI in
# Preview mode (sample data, no sign-in). Production builds without these values
# show a "portal isn't available" page instead — preview never goes live by accident.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Project-wide Supabase upload limit in MB (Dashboard → Storage → Settings →
# "Upload file size limit"). Free plan: 50 (max). Raise it there on a paid plan
# and set the same number here so the upload screen validates sizes correctly.
VITE_MAX_UPLOAD_MB=50

# Edge Function secrets (SITE_URL, ALLOWED_ORIGINS) are NOT set here —
# see supabase/functions/.env.example and supabase/README.md.

# Optional, local testing only: show Preview mode in a production build (`npm run build`)
# that has no Supabase keys. Never set this on Vercel.
# VITE_ENABLE_PREVIEW=true
