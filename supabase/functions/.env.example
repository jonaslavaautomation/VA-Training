# Edge Function secrets. Set them on the hosted project with:
#   supabase secrets set SITE_URL=https://academy.example.com ALLOWED_ORIGINS=https://academy.example.com
# (For `supabase functions serve` locally, copy to supabase/functions/.env.)
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically —
# do NOT add the service-role key to any frontend .env file.

# Public URL of the web app. Invite / reset links send users to $SITE_URL/reset-password.
SITE_URL=http://localhost:5173

# Comma-separated browser origins allowed to call admin-members.
ALLOWED_ORIGINS=http://localhost:5173
